#!/usr/bin/env sh
# Pre-commit progress gate (ses_002-workflow-discipline).
#
# For every in-progress session under .work/sessions/, verify that
# progress.md has been updated at least as recently as the most recent
# staged file. If not, fail with a pointer to the commit skill Step 5.
#
# This hook prevents the failure mode that produced ses_001's six-commit
# gap (2026-04-18 → 2026-04-19) — silent skipping of progress entries
# under flow. The hook does not eliminate bypass; --no-verify still works
# but is forbidden by AGENTS.md <workflow_safety> without explicit user
# permission.
#
# .work/ is gitignored, so progress.md never enters a commit. The
# discipline is the synchronous-update timing, not the commit contents.

set -e

# Resolve the working-memory root. `.work/` is the location; `docs.local/`
# is the name it had before the documentation migration and is still
# honoured, deliberately, so that the gate NEVER lapses while a checkout is
# mid-rename. A hook that quietly stopped gating because its path moved is
# the exact failure this hook exists to prevent, one level up.
#
# Drop the fallback once no checkout carries the old directory.
if [ -f ".work/sessions/README.md" ]; then
  INDEX=".work/sessions/README.md"
elif [ -f "docs.local/sessions/README.md" ]; then
  INDEX="docs.local/sessions/README.md"
  echo "note: working memory is still at docs.local/. Rename it to .work/ —" >&2
  echo "      the gate is running against the old path meanwhile." >&2
else
  # Neither location exists → there are genuinely no sessions to gate.
  exit 0
fi

WORK=$(dirname "$(dirname "$INDEX")")

# Extract in-progress + draft sessions from the index table.
# Rows look like:  | ses_001 | hierarchy-redesign | in-progress | 2026-04-18 | — |
sessions=$(awk -F'|' '
  /^\| ses_/ {
    id = $2; gsub(/[ \t]/, "", id)
    slug = $3; gsub(/^[ \t]+|[ \t]+$/, "", slug)
    state = $4; gsub(/[ \t]/, "", state)
    if (state == "draft" || state == "in-progress") {
      print id "-" slug
    }
  }
' "$INDEX")

[ -z "$sessions" ] && exit 0

# Portable mtime helper (GNU uses -c %Y, BSD/macOS uses -f %m).
#
# GNU stat must be tried FIRST and the result validated as an integer:
# on GNU, `-f` means --file-system and SUCCEEDS, so a `-f`-first probe
# never falls through and returns a block of filesystem stats instead of
# an epoch. That silently broke this gate on Git Bash / Windows, where
# every comparison below then failed with "integer expected".
mtime() {
  # Both probes are expected to fail on the other platform. Keep `set -e`
  # from treating that feature detection as a fatal hook error before the
  # portable fallback can run.
  m=$(stat -c %Y "$1" 2>/dev/null || true)
  case "$m" in ''|*[!0-9]*) m=$(stat -f %m "$1" 2>/dev/null || true) ;; esac
  case "$m" in ''|*[!0-9]*) m='' ;; esac
  printf '%s' "$m"
}

# Newest staged-file mtime.
staged_mtime=0
for f in $(git diff --cached --name-only --diff-filter=ACMR); do
  [ -f "$f" ] || continue
  m=$(mtime "$f")
  [ -n "$m" ] && [ "$m" -gt "$staged_mtime" ] && staged_mtime=$m
done

[ "$staged_mtime" -eq 0 ] && exit 0

failed=""
for sess in $sessions; do
  pfile="${WORK}/sessions/${sess}/progress.md"
  if [ ! -f "$pfile" ]; then
    echo "✗ pre-commit: session ${sess} is active in ${INDEX} but ${pfile} is missing." >&2
    failed=1
    continue
  fi
  pmtime=$(mtime "$pfile")
  if [ -z "$pmtime" ] || [ "$pmtime" -lt "$staged_mtime" ]; then
    echo "✗ pre-commit: ${pfile} is older than staged files. Add an entry per the commit skill Step 5 before committing." >&2
    failed=1
  fi
done

if [ -n "$failed" ]; then
  echo "" >&2
  echo "  Active sessions found in $INDEX:" >&2
  for sess in $sessions; do echo "    - $sess" >&2; done
  echo "" >&2
  echo "  Procedure: .claude/skills/commit/SKILL.md (Step 5)." >&2
  echo "  Bypass (forbidden without explicit user permission): git commit --no-verify ..." >&2
  echo "" >&2
  exit 1
fi

exit 0
