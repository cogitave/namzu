        "name": "session/update",
        "from": "sdk ACP_CLIENT_NOTIFICATIONS.SESSION_UPDATE"
      },
      {
        "name": "namzu/tasks/update",
        "from": "sdk ACP_CLIENT_NOTIFICATIONS.TASK_UPDATE"
      },
      {
        "name": "namzu/session/usage",
