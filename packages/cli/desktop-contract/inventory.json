      {
        "name": "session/request_permission",
        "from": "sdk ACP_CLIENT_REQUESTS.REQUEST_PERMISSION"
      }
    ]
  },
  "flags": {
    "host": {
      "command": "acp",
      "flags": [
        "--desktop"
      ],
      "about": "Started as `<entry> acp --desktop`; any other argument is refused."
    },
    "terminalUi": {
      "flags": [
        "--provider",
        "--model",
        "--effort",
        "--permission-mode",
        "--message"
      ],
      "about": "Passed to the terminal UI of a project view; --message is passed as one argument, `--message=<text>`.",
      "permissionModeValues": [
        "prompt",
        "accept-edits",
        "plan",
        "bypass",
        "auto",
        "strict"
      ]
    },
    "shortCommands": {
      "command": "computer",
      "verbs": [
        "status",
        "setup",
        "stop-idle"
      ],
      "flags": [
        "--json",
        "--yes",
        "--plan",
        "--resume-command",
        "--bundle"
      ]
    }
  },
  "kernelFolder": {
    "about": "Files the application reads from the folder that holds the command line (`<folder>/dist/bin.js`).",
    "files": [
      {
        "path": "dist/bin.js",
        "use": "the entry the application starts"
      },
      {
        "path": "package.json",
        "use": "the command line's version, field `version`"
      },
      {
        "path": "node_modules/@namzu/sdk/package.json",
        "use": "the engine's version, field `version`"
      }
    ]
  },
  "environment": {
    "handsToKernel": [
      {
        "name": "ELECTRON_RUN_AS_NODE",
        "value": "1",
        "about": "the application's own program runs the command line as plain node"
      },
      {
        "name": "NAMZU_PAL_COMPUTER_ENGINE",
        "values": [
          "docker",
          "podman",
          "wslc"
        ],
        "about": "the engine for the Pal computer; the application sets wslc on Windows unless the person chose one"
      },
      {
        "name": "NAMZU_PAL_COMPUTER_BUNDLE",
        "about": "a folder with a manifest.json whose imageRef names the image; the installer carries it"
      }
    ],
    "sharedWithKernel": [
      {
        "name": "NAMZU_HOME",
        "about": "where conversations and the trust list live; the application and the command line read the same one"
      }
    ]
  },
