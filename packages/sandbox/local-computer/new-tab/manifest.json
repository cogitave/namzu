{
  "manifest_version": 3,
  "name": "Namzu workspace",
  "version": "1.0.0",
  "description": "A local New Tab page and installed application launchers for this Pal computer.",
  "key": "",
  "permissions": ["nativeMessaging"],
  "chrome_url_overrides": { "newtab": "home.html" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
  }
}
