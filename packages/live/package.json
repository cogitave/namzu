{
  "name": "@namzu/live",
  "version": "1.0.0",
  "description": "A transport-agnostic live agent runtime for Namzu with pluggable speech, turn-detection, and audio-output drivers.",
  "license": "FSL-1.1-MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "type": "module",
  "homepage": "https://github.com/cogitave/namzu#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cogitave/namzu.git",
    "directory": "packages/live"
  },
  "bugs": {
    "url": "https://github.com/cogitave/namzu/issues"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/*.proc-test.*",
    "!dist/**/__tests__",
    "!dist/**/__fixtures__",
    "!dist/**/test-setup.*",
    "src",
    "!src/**/*.test.*",
    "!src/**/*.proc-test.*",
    "!src/**/__tests__",
    "!src/**/__fixtures__",
    "!src/**/test-setup.*",
    "LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc --build --force",
    "clean": "node -e \"require('node:fs').rmSync('dist', { force: true, recursive: true })\"",
    "dev": "tsc --build --watch",
    "lint": "biome check src/",
    "lint:fix": "biome check --write src/",
    "format": "biome format --write src/",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm --silent build",
    "prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "@namzu/sdk": ">=34.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@namzu/sdk": "workspace:^",
    "@types/node": "^22.19.17",
    "typescript": "^5.5.0",
    "vitest": "^3.2.6",
    "zod": "^3.25.76"
  }
}
