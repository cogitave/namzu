{
	"name": "@namzu/desktop",
	"version": "0.1.0",
	"private": true,
	"description": "Native Namzu operator application backed by the installed CLI runtime.",
	"type": "module",
	"main": "dist/main/index.js",
	"license": "MIT",
	"scripts": {
		"build": "tsc --build && vite build && node scripts/retain-notices.mjs",
		"typecheck": "tsc --noEmit",
		"lint": "biome check src/",
		"test": "vitest run",
		"start": "electron .",
		"dev": "node scripts/dev.mjs",
		"dev:renderer": "node scripts/dev.mjs --renderer-only",
		"dev:check": "node scripts/dev.mjs --check",
		"test:native": "node ../../research/runtime-desktop-20260930/native-smoke.mjs ../.."
	},
	"dependencies": {
		"@base-ui/react": "1.4.1",
		"@headless-tree/core": "1.7.0",
		"@headless-tree/react": "1.7.0",
		"@novnc/novnc": "1.7.0",
		"@pierre/diffs": "1.5.2",
		"@tanstack/react-virtual": "3.14.13",
		"class-variance-authority": "0.7.1",
		"fuzzysort": "4.0.2",
		"ignore": "7.0.12",
		"lucide-react": "0.564.0",
		"react": "19.2.6",
		"react-dom": "19.2.6",
		"react-markdown": "10.1.0",
		"remark-frontmatter": "5.0.0",
		"remark-gfm": "4.0.1",
		"tailwind-merge": "3.4.0",
		"three": "0.186.1",
		"ws": "8.21.3",
		"yaml": "2.9.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@namzu/sdk": "workspace:*",
		"@playwright/test": "1.63.0",
		"@tailwindcss/vite": "4.2.2",
		"@types/react": "^19.2.15",
		"@types/react-dom": "19.2.3",
		"@types/three": "0.186.0",
		"@types/ws": "8.18.1",
		"electron": "44.5.1",
		"tailwindcss": "4.2.2",
		"typescript": "^5.5.0",
		"vite": "8.3.1",
		"vitest": "^4.1.11"
	}
}
