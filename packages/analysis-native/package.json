{
	"name": "@namzu/analysis-native",
	"version": "0.0.0",
	"private": true,
	"description": "Read-only native binary analysis for Namzu: a Rust sidecar (ELF, PE, Mach-O parsing, symbols, strings, Bun and Node SEA payload extraction) and its TypeScript client, plus an asar reader.",
	"license": "FSL-1.1-MIT",
	"engines": {
		"node": ">=22.13.0"
	},
	"type": "module",
	"homepage": "https://github.com/cogitave/namzu#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cogitave/namzu.git",
		"directory": "packages/analysis-native"
	},
	"bugs": {
		"url": "https://github.com/cogitave/namzu/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/__tests__",
		"!dist/**/__fixtures__",
		"src",
		"!src/**/*.test.*",
		"!src/**/__tests__",
		"!src/**/__fixtures__",
		"native/src",
		"native/Cargo.toml",
		"native/Cargo.lock",
		"LICENSE.md"
	],
	"scripts": {
		"build": "node scripts/native.mjs build && tsc --build",
		"dev": "tsc --build --watch",
		"lint": "biome check src/ && node scripts/native.mjs lint",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "node scripts/native.mjs test && vitest run",
		"typecheck": "tsc --noEmit",
		"licenses": "node scripts/check-licenses.mjs --list"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^22.19.17",
		"typescript": "^5.5.0",
		"vitest": "^4.1.11"
	}
}
