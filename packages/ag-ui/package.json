{
	"name": "@namzu/ag-ui",
	"version": "0.1.0",
	"description": "AG-UI protocol adapter for the Namzu agent kernel: typed event streams and Fetch-compatible HTTP handling.",
	"license": "FSL-1.1-MIT",
	"engines": {
		"node": ">=20.0.0"
	},
	"type": "module",
	"homepage": "https://github.com/cogitave/namzu#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/cogitave/namzu.git",
		"directory": "packages/ag-ui"
	},
	"bugs": {
		"url": "https://github.com/cogitave/namzu/issues"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.proc-test.*",
		"!dist/**/__tests__",
		"!dist/**/__fixtures__",
		"!dist/**/test-setup.*",
		"src",
		"!src/**/*.test.*",
		"!src/**/*.proc-test.*",
		"!src/**/__tests__",
		"!src/**/__fixtures__",
		"!src/**/test-setup.*",
		"LICENSE.md",
		"README.md",
		"CHANGELOG.md"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc --build",
		"dev": "tsc --build --watch",
		"lint": "biome check src/",
		"lint:fix": "biome check --write src/",
		"format": "biome format --write src/",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build"
	},
	"peerDependencies": {
		"@namzu/sdk": ">=36.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@namzu/sdk": "workspace:^",
		"@types/node": "^22.19.17",
		"typescript": "^5.5.0",
		"vitest": "^3.2.6",
		"@ag-ui/client": "0.0.59",
		"zod": "^3.23.0"
	},
	"dependencies": {
		"@ag-ui/core": "0.0.59",
		"@ag-ui/encoder": "0.0.59",
		"fast-json-patch": "3.1.1"
	}
}
