node_modules/
dist/
.env
.env.*
!.env.example
*.tsbuildinfo
.DS_Store
coverage/

# Generated runtime state is central. A repository-local .namzu directory is
# reserved for authored project inputs; ignore everything by default so an
# unknown future state writer cannot become commit-visible accidentally.
**/.namzu/*
!**/.namzu/commands/
!**/.namzu/commands/**
!**/.namzu/plugins/
!**/.namzu/plugins/**
!**/.namzu/skills/
!**/.namzu/skills/**

# Local-only packages (not yet published; un-ignore when ready for release)
packages/contracts/
packages/agents/
packages/api/
packages/docs/

# claude-code local launch config (per-machine)
.claude/launch.json
eval-report.json

# Agent worktrees: a background agent gets its own checkout here. It is a
# nested git repository, so committing it would embed a gitlink nobody can
# clone.
.claude/worktrees/
